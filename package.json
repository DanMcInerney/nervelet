{
  "name": "nervelet",
  "version": "0.1.0",
  "description": "Continuous environments for native coding agents, through a local CLI.",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "bin": { "nervelet": "dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./demo": { "types": "./dist/adapters/demo.d.ts", "import": "./dist/adapters/demo.js" },
    "./serial": { "types": "./dist/adapters/serial.d.ts", "import": "./dist/adapters/serial.js" },
    "./claude-code": { "types": "./dist/harnesses/claude-code.d.ts", "import": "./dist/harnesses/claude-code.js" },
    "./codex": { "types": "./dist/harnesses/codex.d.ts", "import": "./dist/harnesses/codex.js" }
  },
  "files": ["dist", "examples", "README.md", "DESIGN.md", "docs"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.ts",
    "check": "npm test",
    "demo": "node dist/cli.js demo",
    "prepack": "npm run build"
  },
  "dependencies": { "ajv": "^8.17.1" },
  "optionalDependencies": { "serialport": "^13.0.0" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "~5.9.3" }
}

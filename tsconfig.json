{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist", "declaration": true,
    "strict": true, "noUncheckedIndexedAccess": true, "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
